# NordVPN access token
# https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
NORDVPN_TOKEN=

# Country for the recommended server. Empty = nearest recommended by NordVPN.
# Common ids: 97 Hong Kong, 108 Japan, 114 South Korea, 195 Singapore, 211 Taiwan, 228 USA, 227 UK, 81 Germany, 153 Netherlands
# Full list: https://api.nordvpn.com/v1/servers/countries
COUNTRY_ID=114

# Local ports wireproxy listens on (SOCKS5 for Cursor IDE, HTTP for cursor-agent CLI)
SOCKS_PORT=8964
HTTP_PORT=8965
